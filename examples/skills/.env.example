# Your Pinecall API key — skills need the server-side LLM (paid org)
PINECALL_API_KEY=pk_...

# The slug this agent registers as — must match `agent:` in the spec files
AGENT=skills

# A number in your org to answer on (E.164). Leave empty for browser only.
PHONE=

# Only needed for `npm test` — the judge that talks to the agent runs locally
ANTHROPIC_API_KEY=sk-ant-...
