# Your Pinecall API key
PINECALL_API_KEY=pk_...

# The slug this agent registers as
AGENT=whatsapp-dashboard

# Meta WhatsApp Cloud API — the phone number id, not the phone number
WA_PHONE_NUMBER_ID=123456789012345

# Meta access token for that app
WA_ACCESS_TOKEN=EAA...

# The webhook verify token you typed into the Meta console
WA_VERIFY_TOKEN=pinecall-wa-verify

# Meta app secret — optional, verifies the webhook signature
WA_APP_SECRET=

# Port the dashboard listens on
PORT=3000
