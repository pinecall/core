# Your Pinecall API key
PINECALL_API_KEY=pk_...

# The slug this agent registers as — must match `agent:` in order.spec.yaml
AGENT=tools

# A number in your org to answer on (E.164). Leave empty for browser only.
PHONE=

# A/B the model without editing server.mjs
LLM=openai/gpt-4.1-mini

# Only needed for `npm test` — the judge that talks to the agent runs locally
ANTHROPIC_API_KEY=sk-ant-...
