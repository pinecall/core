# Your Pinecall API key
PINECALL_API_KEY=pk_...

# The slug this agent registers as
AGENT=turn-detection

# A number in your org to answer on (E.164). Leave empty for browser only.
PHONE=

# Who decides the turn: "flux" (native, fastest) or "nova" (SmartTurn + Silero)
MODEL=flux

# Language code: en, es, ar, fr, de, pt — picks the STT language and the voice.
# Not LANG: that name is already taken by the shell's own locale variable.
STT_LANG=en
