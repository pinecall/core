# Your Pinecall API key
PINECALL_API_KEY=pk_...

# The number this line claims and answers (E.164) — `pinecall phones` lists yours
LINE_NUMBER=+15550001111

# The agent slug option 0 hands the live call to — it must be online to take it
AGENT=reception

# A real phone number option 3 forwards to. Leave empty and option 3 apologises.
HUMAN=

# Override the voice server — only the smoke test needs this
# PINECALL_URL=ws://127.0.0.1:9000
